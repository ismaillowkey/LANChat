<Window x:Class="LanChat.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:LanChat.Wpf.Converters"
        mc:Ignorable="d"
        Title="{Binding Strings.AppTitle}" Height="750" Width="1180" MinWidth="1100" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Icon="Resources/app_logo.png"
        Background="#F8FAFC" Foreground="#0F172A"
        FontFamily="Segoe UI, Inter, Roboto, Arial">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:ByteArrayToImageConverter x:Key="ByteArrayToImageConverter"/>
        <converters:BoolToHorizontalAlignmentConverter x:Key="BoolToHorizontalAlignmentConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

        <!-- Bendera Indonesia Vector Template -->
        <ControlTemplate x:Key="IndonesianFlagTemplate">
            <Border Width="22" Height="15" CornerRadius="3" BorderBrush="#94A3B8" BorderThickness="0.8" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Rectangle Grid.Row="0" Fill="#E11D48"/>
                    <Rectangle Grid.Row="1" Fill="#FFFFFF"/>
                </Grid>
            </Border>
        </ControlTemplate>

        <!-- Bendera Inggris (UK Union Jack) Vector Template -->
        <ControlTemplate x:Key="EnglishFlagTemplate">
            <Border Width="22" Height="15" CornerRadius="3" BorderBrush="#94A3B8" BorderThickness="0.8" ClipToBounds="True">
                <Viewbox Stretch="Fill">
                    <Grid Width="60" Height="36" Background="#012169">
                        <!-- White diagonal saltire -->
                        <Path Data="M0,0 L60,36 M60,0 L0,36" Stroke="#FFFFFF" StrokeThickness="10"/>
                        <!-- Red diagonal saltire -->
                        <Path Data="M0,0 L60,36 M60,0 L0,36" Stroke="#C8102E" StrokeThickness="4"/>
                        <!-- White cross -->
                        <Rectangle Fill="#FFFFFF" Width="14" Height="36" HorizontalAlignment="Center"/>
                        <Rectangle Fill="#FFFFFF" Height="14" Width="60" VerticalAlignment="Center"/>
                        <!-- Red cross -->
                        <Rectangle Fill="#C8102E" Width="8" Height="36" HorizontalAlignment="Center"/>
                        <Rectangle Fill="#C8102E" Height="8" Width="60" VerticalAlignment="Center"/>
                    </Grid>
                </Viewbox>
            </Border>
        </ControlTemplate>

        <!-- LAN Network Vector Icon Template -->
        <ControlTemplate x:Key="LanIconTemplate">
            <Viewbox Width="18" Height="18">
                <Canvas Width="24" Height="24">
                    <!-- Central Hub Line -->
                    <Path Stroke="#4F46E5" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M3,17 L21,17 M12,17 L12,13 M6,17 L6,11 M18,17 L18,11"/>
                    <!-- Node 1 (Left PC) -->
                    <Rectangle Canvas.Left="3" Canvas.Top="5" Width="6" Height="6" RadiusX="1" RadiusY="1" Fill="#EEF2FF" Stroke="#4F46E5" StrokeThickness="1.5"/>
                    <!-- Node 2 (Center PC) -->
                    <Rectangle Canvas.Left="9" Canvas.Top="7" Width="6" Height="6" RadiusX="1" RadiusY="1" Fill="#EEF2FF" Stroke="#4F46E5" StrokeThickness="1.5"/>
                    <!-- Node 3 (Right PC) -->
                    <Rectangle Canvas.Left="15" Canvas.Top="5" Width="6" Height="6" RadiusX="1" RadiusY="1" Fill="#EEF2FF" Stroke="#4F46E5" StrokeThickness="1.5"/>
                    <!-- Connection indicator -->
                    <Ellipse Canvas.Left="10.5" Canvas.Top="18.5" Width="3" Height="3" Fill="#10B981"/>
                </Canvas>
            </Viewbox>
        </ControlTemplate>

        <!-- Chat Speech Bubble Vector Icon Template -->
        <ControlTemplate x:Key="ChatIconTemplate">
            <Viewbox Width="18" Height="18">
                <Canvas Width="24" Height="24">
                    <Path Fill="#4F46E5" Data="M20,2 H4 C2.9,2 2,2.9 2,4 V15 C2,16.1 2.9,17 4,17 H18 L22,21 V4 C22,2.9 21.1,2 20,2 Z"/>
                    <Ellipse Canvas.Left="6" Canvas.Top="8.5" Width="2.5" Height="2.5" Fill="White"/>
                    <Ellipse Canvas.Left="10.75" Canvas.Top="8.5" Width="2.5" Height="2.5" Fill="White"/>
                    <Ellipse Canvas.Left="15.5" Canvas.Top="8.5" Width="2.5" Height="2.5" Fill="White"/>
                </Canvas>
            </Viewbox>
        </ControlTemplate>

        <!-- ScrollBar Minimal Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#4F46E5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4338CA"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E2E8F0"/>
                    <Setter Property="Foreground" Value="#94A3B8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E2E8F0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top App Bar -->
            <RowDefinition Height="68"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP APP BAR (LIGHT THEME) -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App Brand (LAN & Chat Icons + Logo) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#EEF2FF" CornerRadius="10" Width="42" Height="42" Margin="0,0,12,0" 
                            ClipToBounds="True" BorderBrush="#C7D2FE" BorderThickness="1.5">
                        <Image Source="Resources/app_logo.png" Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="LAN CHAT" FontWeight="Bold" FontSize="16" Foreground="#0F172A" Margin="0,0,6,0"/>
                            <Border Background="#F1F5F9" CornerRadius="4" Padding="5,1" Margin="0,0,8,0" VerticalAlignment="Center" BorderBrush="#E2E8F0" BorderThickness="1">
                                <TextBlock Text="v0.2.3" FontSize="10" FontWeight="SemiBold" Foreground="#475569"/>
                            </Border>
                            <!-- LAN + Chat Vector Badges -->
                            <Border Background="#EEF2FF" CornerRadius="6" Padding="6,3" BorderBrush="#C7D2FE" BorderThickness="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Control Template="{StaticResource LanIconTemplate}" Margin="0,0,5,0" ToolTip="Local Area Network Connected"/>
                                    <Control Template="{StaticResource ChatIconTemplate}" ToolTip="Instant Messenger Ready"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Strings.SubTitle}" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Network Info Badge -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#F1F5F9" CornerRadius="8" Padding="14,6" BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Control Template="{StaticResource LanIconTemplate}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0"/>
                            <TextBlock Text="IP: " Foreground="#64748B" FontSize="12"/>
                            <TextBlock Text="{Binding Manager.LocalIpAddress}" FontWeight="SemiBold" Foreground="#0F172A" FontSize="12" Margin="0,0,12,0"/>
                            <TextBlock Text="Port: " Foreground="#64748B" FontSize="12"/>
                            <TextBlock Text="{Binding Manager.LocalTcpPort}" FontWeight="SemiBold" Foreground="#0F172A" FontSize="12" Margin="0,0,12,0"/>
                            <TextBlock Text="MAC: " Foreground="#64748B" FontSize="12"/>
                            <TextBlock Text="{Binding Manager.LocalMacAddress}" FontWeight="SemiBold" Foreground="#4F46E5" FontSize="11"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Local Device Name Setting & Language Toggle -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Strings.MyDeviceLabel}" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                    <TextBox Text="{Binding EditableDeviceName, UpdateSourceTrigger=PropertyChanged}" 
                             Width="150" Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" 
                             BorderThickness="1" Padding="8,6" VerticalAlignment="Center" FontSize="12">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                    <Button Content="{Binding Strings.Change}" Style="{StaticResource ModernButton}" Margin="8,0,0,0"
                            Padding="12,6" FontSize="12" Command="{Binding SaveDeviceNameCommand}" ToolTip="{Binding Strings.SaveDeviceTooltip}"/>
                    <Button Content="{Binding Strings.MediaFolder}" Style="{StaticResource ModernButton}" Margin="8,0,0,0"
                            Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1"
                            Padding="10,6" FontSize="12" Command="{Binding OpenAppMediaFolderCommand}" 
                            ToolTip="{Binding Strings.MediaFolderTooltip}"/>
                    <!-- Segmented Flag Language Switcher (Indonesia & Inggris) -->
                    <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="2" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <!-- Indonesian Flag Button -->
                            <Button Command="{Binding SetIndonesianCommand}" ToolTip="Bahasa Indonesia" Cursor="Hand" Margin="0,0,2,0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="Padding" Value="7,4"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" 
                                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Strings.IsIndonesian}" Value="True">
                                                <Setter Property="Background" Value="#FFFFFF"/>
                                                <Setter Property="BorderBrush" Value="#6366F1"/>
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.12" Color="#000000"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="0.85"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Control Template="{StaticResource IndonesianFlagTemplate}" VerticalAlignment="Center"/>
                                    <TextBlock Text="ID" FontWeight="Bold" FontSize="11" Margin="5,0,2,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#64748B"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Strings.IsIndonesian}" Value="True">
                                                        <Setter Property="Foreground" Value="#4338CA"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>

                            <!-- English Flag Button -->
                            <Button Command="{Binding SetEnglishCommand}" ToolTip="English" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="Padding" Value="7,4"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" 
                                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Strings.IsEnglish}" Value="True">
                                                <Setter Property="Background" Value="#FFFFFF"/>
                                                <Setter Property="BorderBrush" Value="#6366F1"/>
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.12" Color="#000000"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="0.85"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Control Template="{StaticResource EnglishFlagTemplate}" VerticalAlignment="Center"/>
                                    <TextBlock Text="EN" FontWeight="Bold" FontSize="11" Margin="5,0,2,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#64748B"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Strings.IsEnglish}" Value="True">
                                                        <Setter Property="Foreground" Value="#4338CA"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN LAYOUT (SIDEBAR + CHAT) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Device / Peer List Sidebar -->
                <ColumnDefinition Width="320"/>
                <!-- Chat Window -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Sidebar Header with LAN Icon -->
                    <Border Grid.Row="0" Background="#F8FAFC" Padding="16,14" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Control Template="{StaticResource LanIconTemplate}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Strings.DevicesOnLan}" FontWeight="Bold" FontSize="11" Foreground="#475569" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Strings.DevicesOnLanSub}" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Peer List (ListBox) -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding Manager.Peers}" 
                             SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" Margin="8,8"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="8" Padding="12,10" Margin="0,2">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#F1F5F9"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#EEF2FF"/>
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#6366F1"/>
                                                    <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Icon Circle (LAN/Chat/Device) -->
                                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19" 
                                            Background="#EEF2FF" Margin="0,0,10,0">
                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <!-- If Broadcast: Show Broadcast/LAN icon -->
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="💻"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsBroadcastTarget}" Value="True">
                                                                <Setter Property="Text" Value="📢"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>

                                    <!-- Name, MAC Address, IP -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <!-- Device Name -->
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#0F172A" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                        
                                        <!-- MAC Address (Kecil di bawah nama device) -->
                                        <TextBlock Text="{Binding MacAddress, StringFormat='MAC: {0}'}" FontSize="10" Foreground="#64748B" Margin="0,1,0,0"/>

                                        <!-- IP Address -->
                                        <TextBlock Text="{Binding IpAddress, StringFormat='IP: {0}'}" FontSize="11" Foreground="#475569" Margin="0,1,0,0"/>
                                    </StackPanel>

                                    <!-- Notification Bell & Online Indicator -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                        <!-- Notification Bell Badge (Muncul saat ada chat direct baru) -->
                                        <Border Background="#FEE2E2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="10" 
                                                Padding="6,2" Margin="0,0,6,0" 
                                                Visibility="{Binding HasUnread, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🔔" FontSize="11" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding UnreadCount}" FontSize="10" FontWeight="Bold" Foreground="#DC2626" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Online / Offline Status Dot -->
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#10B981"/>
                                                    <Setter Property="ToolTip" Value="Online"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                            <Setter Property="Fill" Value="#94A3B8"/>
                                                            <Setter Property="ToolTip" Value="Offline"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- RIGHT CHAT AREA -->
            <Grid Grid.Column="1" Background="#F8FAFC">
                <Grid.RowDefinitions>
                    <!-- Chat Header -->
                    <RowDefinition Height="56"/>
                    <!-- Message Feed -->
                    <RowDefinition Height="*"/>
                    <!-- Input Bar -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Chat Header with Chat Icon -->
                <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Control Template="{StaticResource ChatIconTemplate}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Strings.ChatRoom}" Foreground="#64748B" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SelectedTarget.DisplayName}" FontWeight="Bold" FontSize="14" Foreground="#4F46E5" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Chat Mode Indicator Badge -->
                        <Border Grid.Column="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FCE7F3"/>
                                    <Setter Property="BorderBrush" Value="#F472B6"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTarget.IsBroadcastTarget}" Value="True">
                                            <Setter Property="Background" Value="#DBEAFE"/>
                                            <Setter Property="BorderBrush" Value="#93C5FD"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding CurrentChatModeBadgeText}" FontSize="11" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#9D174D"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedTarget.IsBroadcastTarget}" Value="True">
                                                <Setter Property="Foreground" Value="#1E40AF"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </Grid>
                </Border>

                <!-- Messages List -->
                <ScrollViewer Grid.Row="1" x:Name="MessagesScrollViewer" Padding="20,16" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding MessagesView}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6" HorizontalAlignment="{Binding IsOutgoing, Converter={StaticResource BoolToHorizontalAlignmentConverter}}">
                                    <Border CornerRadius="12" Padding="14,10" MaxWidth="500">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FFFFFF"/>
                                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOutgoing}" Value="True">
                                                        <Setter Property="Background" Value="#4F46E5"/>
                                                        <Setter Property="BorderBrush" Value="#4338CA"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <StackPanel>
                                            <!-- Message Header (Sender & Type Badge) -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <!-- Sender Name -->
                                                    <TextBlock Text="{Binding SenderName}" FontWeight="Bold" FontSize="12">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#0F172A"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsOutgoing}" Value="True">
                                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <!-- Direct / Broadcast Badge -->
                                                    <Border Margin="8,0,0,0" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#DBEAFE"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDirect}" Value="True">
                                                                        <Setter Property="Background" Value="#FCE7F3"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock FontSize="10" FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="Broadcast"/>
                                                                    <Setter Property="Foreground" Value="#1E40AF"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsDirect}" Value="True">
                                                                            <Setter Property="Text" Value="Direct"/>
                                                                            <Setter Property="Foreground" Value="#9D174D"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Formatted Time -->
                                                <TextBlock Grid.Column="1" Text="{Binding FormattedTime}" FontSize="11" Margin="8,0,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#94A3B8"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOutgoing}" Value="True">
                                                                    <Setter Property="Foreground" Value="#E0E7FF"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>

                                            <!-- Image Display (If present & file exists on local disk) -->
                                            <Border CornerRadius="8" Margin="0,4" MaxHeight="300"
                                                    Visibility="{Binding HasImagePreview, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Image Source="{Binding ImageData, Converter={StaticResource ByteArrayToImageConverter}}" 
                                                       Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Border>

                                            <!-- Missing / Deleted Image Fallback (WhatsApp style: shows sender notice when file was deleted from folder) -->
                                            <Border CornerRadius="8" Margin="0,4" Padding="12,10"
                                                    Visibility="{Binding IsMissingImage, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#F1F5F9"/>
                                                        <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOutgoing}" Value="True">
                                                                <Setter Property="Background" Value="#3730A3"/>
                                                                <Setter Property="BorderBrush" Value="#4338CA"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" 
                                                            Background="#EEF2FF" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <TextBlock Text="📷" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <!-- e.g. "Ismail mengirim gambar" or "Anda mengirim gambar" -->
                                                        <TextBlock Text="{Binding MissingMediaNotice}" FontWeight="SemiBold" FontSize="12">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#0F172A"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsOutgoing}" Value="True">
                                                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding DataContext.Strings.ImageDeletedNotice, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                   FontSize="10" FontStyle="Italic" Margin="0,2,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#64748B"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsOutgoing}" Value="True">
                                                                            <Setter Property="Foreground" Value="#CBD5E1"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Video Display Card (If present) -->
                                            <Border CornerRadius="8" Margin="0,4" Padding="12,10"
                                                    Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#F1F5F9"/>
                                                        <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOutgoing}" Value="True">
                                                                <Setter Property="Background" Value="#3730A3"/>
                                                                <Setter Property="BorderBrush" Value="#4338CA"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" 
                                                            Background="#EEF2FF" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <TextBlock Text="🎬" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#0F172A"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsOutgoing}" Value="True">
                                                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding FormattedFileSize}" FontSize="10" Margin="0,2,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#64748B"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsOutgoing}" Value="True">
                                                                            <Setter Property="Foreground" Value="#C7D2FE"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <!-- Action Buttons -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                                        <Button Content="{Binding DataContext.Strings.PlayVideo, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                Style="{StaticResource ModernButton}" Padding="10,5" FontSize="11" Margin="0,0,6,0"
                                                                Command="{Binding DataContext.PlayMediaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" 
                                                                ToolTip="{Binding DataContext.Strings.PlayVideoTooltip, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                        <Button Content="📂" Style="{StaticResource IconButton}" Padding="8,5" FontSize="11"
                                                                Command="{Binding DataContext.OpenMediaFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" 
                                                                ToolTip="{Binding DataContext.Strings.OpenVideoFolderTooltip, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Text Content (If present) -->
                                            <TextBlock Text="{Binding Content}" FontSize="13" TextWrapping="Wrap"
                                                       Visibility="{Binding Content, Converter={StaticResource NullToVisibilityConverter}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#1E293B"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOutgoing}" Value="True">
                                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Input Footer -->
                <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Attach Photo and Video Buttons -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,10,0">
                            <!-- Attach Photo Button -->
                            <Button Command="{Binding AttachImageCommand}" Style="{StaticResource IconButton}" Margin="0,0,6,0" ToolTip="{Binding Strings.AttachImageTooltip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📷" FontSize="15" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding Strings.Photo}" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Attach Video Button -->
                            <Button Command="{Binding AttachVideoCommand}" Style="{StaticResource IconButton}" ToolTip="{Binding Strings.AttachVideoTooltip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎥" FontSize="15" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding Strings.Video}" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Text Input -->
                        <TextBox Grid.Column="1" x:Name="InputTextBox"
                                 Text="{Binding MessageInput, UpdateSourceTrigger=PropertyChanged}" 
                                 Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#CBD5E1" 
                                 BorderThickness="1" Padding="12,10" FontSize="13" 
                                 VerticalContentAlignment="Center" KeyDown="InputTextBox_KeyDown">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>

                        <!-- Send Button -->
                        <Button Grid.Column="2" Command="{Binding SendMessageCommand}" Style="{StaticResource ModernButton}" Margin="10,0,0,0" ToolTip="{Binding Strings.SendTooltip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Strings.Send}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="➤" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
